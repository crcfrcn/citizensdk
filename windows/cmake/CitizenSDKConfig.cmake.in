@PACKAGE_INIT@

if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
   (DEFINED CITIZENSDK_PLATFORM AND NOT CITIZENSDK_PLATFORM STREQUAL "Windows"))
  set(CitizenSDK_FOUND FALSE)
  set(CitizenSDK_NOT_FOUND_MESSAGE "CitizenSDK Windows package requires a matching Windows consumer")
  return()
endif()
set(CITIZENSDK_PLATFORM "Windows")
set(CITIZENSDK_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(CITIZENSDK_RUNTIME_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(CITIZENSDK_ASSET_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/citizensdk/chain")
include("${CMAKE_CURRENT_LIST_DIR}/CitizenSDKDependencies.cmake")
if(NOT CitizenSDK_FOUND)
  return()
endif()
if(NOT TARGET CitizenSDK::Core)
  add_library(CitizenSDK::Core SHARED IMPORTED)
  set_target_properties(CitizenSDK::Core PROPERTIES
    IMPORTED_LOCATION "${CITIZENSDK_RUNTIME_DIR}/Windows/citizensdk.dll"
    IMPORTED_IMPLIB "${CITIZENSDK_LIBRARY_DIR}/Windows/citizensdk.dll.lib"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CitizenSDKTargets.cmake")
# 安装包的公开 Host 链接合同只有同包 Core；私有系统与静态依赖已在 Host DLL 内。
# 导入后明确收口，避免生成器附带的链接属性传给独立消费者或 Flutter 插件。
set_property(TARGET CitizenSDK::Host PROPERTY
  INTERFACE_LINK_LIBRARIES CitizenSDK::Core)
check_required_components(CitizenSDK)
