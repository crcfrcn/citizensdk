# CitizenSDK's generated package-version contract: callers may consume an
# equal or newer release within major version 1, never a newer requested
# version or a different ABI major.
set(PACKAGE_VERSION "@PROJECT_VERSION@")
if(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL @PROJECT_VERSION_MAJOR@ AND
   NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
else()
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
